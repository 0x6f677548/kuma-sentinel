# Kuma Sentinel Docker Configuration
# Copy this file to .env and update with your configuration

# === Logging Configuration ===
# KUMA_SENTINEL_LOG_FILE=/var/log/kuma-sentinel/kuma-sentinel.log

# === Nmap Port Scanning Configuration ===
# KUMA_SENTINEL_PORTSCAN_NMAP_PORTS=1-1000
# KUMA_SENTINEL_PORTSCAN_NMAP_TIMING=T3
# KUMA_SENTINEL_PORTSCAN_NMAP_ARGUMENTS=
# KUMA_SENTINEL_PORTSCAN_EXCLUDE="192.168.1.1,192.168.1.254"

# === Heartbeat Configuration ===
# KUMA_SENTINEL_HEARTBEAT_ENABLED=true
# KUMA_SENTINEL_HEARTBEAT_INTERVAL=300

# === Uptime Kuma Integration ===
# UPTIME_KUMA_URL=http://uptime-kuma:3001/api/push
# UPTIME_KUMA_HEARTBEAT_TOKEN=your_heartbeat_token_here
# UPTIME_KUMA_PORTSCAN_TOKEN=your_portscan_token_here
